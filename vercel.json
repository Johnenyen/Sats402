{
  "buildCommand": "npm run build && mkdir -p public && cp apps/site/index.html public/index.html && cp apps/receipts/page.html public/receipts.html",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/demo/call.mjs": { "maxDuration": 60 },
    "api/s2/complete.mjs": { "maxDuration": 60 },
    "api/s1/stats.mjs": { "maxDuration": 30 },
    "api/receipt/[txid].mjs": { "maxDuration": 30 },
    "api/verify-payment.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/receipts", "destination": "/receipts.html" },
    { "source": "/receipt/:txid", "destination": "/api/receipt/:txid" }
  ]
}
