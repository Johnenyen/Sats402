{
  "name": "sats402-monorepo",
  "private": true,
  "description": "Sats402: SDK and protocol for x402 pay-per-request payments in native sats on Tachi. Example app: one command.",
  "license": "MIT",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node scripts/dev-server.mjs",
    "stage-site": "node scripts/stage-site.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "npm test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "cold-start": "node demo/cold-start.mjs",
    "demo:pay": "node demo/pay.mjs",
    "verify": "node packages/cli/bin/sats402.mjs verify"
  }
}
